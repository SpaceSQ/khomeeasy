# Supabase project ref: dvnnppisrgiyyvcvfoom
# Region: Frankfurt (eu-central-1). Do not move this project to another region.
# Next.js reads env from apps/web. Keep apps/web/.env.local in sync with this file.

NEXT_PUBLIC_SUPABASE_URL=https://dvnnppisrgiyyvcvfoom.supabase.co

# Project Settings → API → anon / publishable key. Safe to expose to the browser.
# Leave empty until you paste the real key. Do not invent one.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings → API → service_role. Server-only. Never use the NEXT_PUBLIC_ prefix.
# Leave empty until you paste the real key. Never commit a filled-in copy of this file.
SUPABASE_SERVICE_ROLE_KEY=
